# Where the data comes from
DATA_SOURCE=csv

# Only used when DATA_SOURCE=csv
DATA_DIR=data

# The experiment workbook, used by `limodel convert` and `limodel verify`
WORKBOOK=~/Downloads/ED_data_from M-V.xlsx

# The membranes the modelling is about; a run on any other is dropped in preprocessing
MEMBRANES_MODELLED=GO-10

# The limits a recommended setup has to clear. The floor is a judgement that may be revised;
# the ceiling is physical, the point above which the membranes fail.
RECOVERY_FLOOR_PCT=35.0
VOLTAGE_CEILING_V=20.0
